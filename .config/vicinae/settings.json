// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": false,
   "escape_key_behavior": "close_window",
   "keybinding": "vim",
   "font": {
      "rendering": "qt",
      "normal": {
         "family": "SF Pro Text",
         "size": 9.5
      }
   },
   "theme": {
      "dark": {
         "name": "rose-pine",
         "icon_theme": "Adwaita"
      }
   },
   "telemetry": {
      "system_info": false
   },
   "launcher_window": {
      "rounding": 21,
      "opacity": 1,
      "client_side_decorations": {
         "border_width": 0,
         "shadow_size": 12
      },
      "compact_mode": {
         "enabled": true
      }
   },
   "fallbacks": [],
   "providers": {
      "@Ninetonine/store.vicinae.searxng": {
         "preferences": {
            "instance_domain": "https://serxng-deployment-production.up.railway.app",
            "default_category": "general",
            "details_start_open": false,
            "engines": "",
            "keep_previous_search": true,
            "languages": ""
         }
      },
      "@dagimg-dot/store.vicinae.wifi-commander": {
         "preferences": {
            "network-cli-tool": "nmcli"
         }
      },
      "@jag-k/store.raycast.duckduckgo-image-search": {
         "preferences": {
            "locale": "en-us",
            "retries": "5",
            "saveDirectory": "~/Downloads",
            "sleep": "2000"
         },
         "entrypoints": {
            "search-image": {
               "preferences": {
                  "license": "",
                  "moderate": false
               }
            }
         }
      },
      "@sameoldlab/store.vicinae.fuzzy-files": {
         "enabled": false
      },
      "@sovereign/store.vicinae.hypr-keybinds": {
         "entrypoints": {
            "hyprland-keybinds": {
               "enabled": false
            }
         }
      },
      "clipboard": {
         "enabled": false,
         "preferences": {
            "monitoring": false
         }
      },
      "core": {
         "entrypoints": {
            "sponsor": {
               "enabled": false
            }
         }
      },
      "files": {
         "enabled": false,
         "preferences": {
            "autoIndexing": false,
            "excludedIndexingPaths": [],
            "indexingPaths": [
               "/home/bi"
            ]
         },
         "entrypoints": {
            "search": {
               "alias": "sf"
            }
         }
      },
      "media": {
         "entrypoints": {
            "volume-0": {
               "enabled": false
            },
            "volume-100": {
               "enabled": false
            },
            "volume-25": {
               "enabled": false
            },
            "volume-50": {
               "enabled": false
            },
            "volume-75": {
               "enabled": false
            },
            "volume-down": {
               "enabled": false
            },
            "volume-up": {
               "enabled": false
            }
         }
      },
      "power": {
         "entrypoints": {
            "hibernate": {
               "enabled": false
            },
            "power-off": {
               "enabled": false
            },
            "reboot": {
               "enabled": false
            },
            "suspend": {
               "enabled": false
            }
         }
      },
      "snippets": {
         "preferences": {
            "enabled": true,
            "undo": true,
            "layout": "",
            "prePasteDelay": "0",
            "keyDelay": "2"
         }
      },
      "system": {
         "entrypoints": {
            "browse-apps": {
               "enabled": true
            }
         }
      }
   }
}