{
  "layer": "top",
  "position": "top",
  "margin-bottom": 1,
  "height": 20,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["mpris", "battery", "pulseaudio", "network"],
  "style": "/home/bi/dotfiles/.config/waybar/style.css",

  "battery": {
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""],
  },
  "clock": {
    "format-alt": "{:%a, %d. %b  %H:%M}",
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
      "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
      "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": ["", ""],
    },
    //default scroll step is 1
    //scroll step is the amount of volume changed when scrolling
    // changed it for trackpad fine grained control
    "scroll-step": 0.3,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"],
  },

  //Custom mpris module 
  // This is a custom module that i added to show the current playing song in the waybar
  // uses playerctl to get the current playing song
"mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "⏸ <i><u>{title}</u></i>",
        "player-icons": {
            "default": "▶",
            "mpv": "🎵",
            "spotify": "",
            "firefox": ""
        },
        "status-icons": {
            "paused": "⏸"
        },
        // "ignored-players": ["firefox"], // Use this if you don't want to track videos in browser
        "max-length": 25,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-left": "playerctl previous" // Usually left is click, so you might want middle or double for prev
        // "on-scroll-up": "playerctl next",
        // "on-scroll-down": "playerctl previous"
    },

  "network": {
    "interface": "wlo1",
    // "format": "{ifname}",
    "format-wifi": "{essid} ({signalStrength}%) ",
    "format-ethernet": "{ipaddr}/{cidr} 󰊗",
    "format-disconnected": "", //An empty format will hide the module.
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": {
      "*": 10
    }
  },
}
