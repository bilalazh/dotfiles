{
  "layer": "top",
  "position": "top",
  "margin-bottom": 0,
  "margin-top": 0,
  "spacing": 2,
  "height": 16,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "mpris",
    "battery",
    "pulseaudio",
    "network",
    "custom/handy",
    "custom/notification"
  ],
  "battery": {
    "states": {
      "full": 100,
      "good": 90,
      "medium": 85,
      "low": 35,
      "critical": 15
    },
    "tooltip": true,
    "tooltip-format-charging": "Charging  {capacity}%",
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "clock": {
    "interval": 60,
    "format": " {:%H:%M}",
    "format-alt": " {:%A, %B %d, %Y}",
    "tooltip-format": "<tt>{:%I:%M %p}\n{:%A, %B %d, %Y}</tt>",
    "tooltip": true
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂰 {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰏲",
      "car": "󰄄",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "scroll-step": 0.3,
    "on-click": "pavucontrol",
    "ignored-sinks": [
      "Easy Effects Sink"
    ]
  },
  //Custom mpris module 
  // This is a custom module that i added to show the current playing song in the waybar
  // uses playerctl to get the current playing song
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "⏸ <i><u>{title}</u></i>",
    "player-icons": {
      "default": "▶",
      "mpv": "🎵",
      "spotify": "",
      "firefox": ""
    },
    "status-icons": {
      "paused": "⏸"
    },
    // "ignored-players": ["firefox"], // Use this if you don't want to track videos in browser
    "max-length": 25,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous"
    // "on-scroll-up": "playerctl next",
    // "on-scroll-down": "playerctl previous"
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "network": {
    "interface": "wlo1",
    "format-wifi": "{icon} {signalStrength}%",
    "format-ethernet": "󰈀 {ipaddr}/{cidr}",
    "format-linked": "� {ifname} (No IP)",
    "format-disconnected": "󰤮 Disconnected",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) {icon}",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click": "foot --app-id nmtui-float -e nmtui", 
    "on-click-right":"bash /home/bi/dotfiles/.config/hypr/scripts/toggle-wifi.sh"
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "active-only": true
  },
  "custom/handy": {
    "exec": "/home/bi/dotfiles/.config/waybar/handy-waybar.sh --status",
    "return-type": "json",
    "interval": 1,
    "on-click": "/home/bi/dotfiles/.config/waybar/handy-waybar.sh",
    "format": "{}"
  }
}