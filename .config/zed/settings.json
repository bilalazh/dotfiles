// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "tool_permissions": {
      "default": "allow"
    },
    "default_profile": "write",
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-flash"
    }
  },

  //Opencode Cli integration using ACP
  "agent_servers": {
    "OpenCode": {
      "type": "custom",
      "command": "opencode-cli",
      "args": ["acp"]
    }
  },

  "vim_mode": true,
  "ui_font_size": 11,
  "ui_font_weight": 500,
  "buffer_font_size": 12,
  "buffer_font_family": "GeistMono Nerd Font Propo",
  "buffer_font_weight": 500,
  "ui_font_family": "GeistMono Nerd Font Propo",
  
  "terminal": {
    "font_family": "GeistMono Nerd Font Mono",
    "font_size": 11,
    "font_weight": 500
  },
  // This size is only applicable for the agent window
  "agent_ui_font_size": 11,
  "theme": "Gruvbox Light Hard",
  "autosave": {
    "after_delay": {
      "milliseconds": 1500
    }
  },
  "auto_update": false
}
