// Load with --load-config examples/2.jsonc
// Note that you must replace the image path to an existing image to display it.

{
  "$schema": "./json_schema.json",
"logo": {
    "type": "file-raw",
    "source": "/home/bi/dotfiles/.config/fastfetch/file.txt",
    "width": 25,
    "height": 15,
    "preserveAspectRatio": true
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "white",
      "output": "white"
    }
  },
  "modules": [
    {
      "type": "title",
      "key": "",
      "format": "{1}@{2}"
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "format": "{1}"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "format": "{1} ({3} cores)"
    },
    {
      "type": "disk",
      "key": "Storage",
      "folder": "/",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "memory",
      "key": "Memory",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    }
  ]
}
